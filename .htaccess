# Wordless — Apache / LiteSpeed (o2switch, OVH, Hostinger, Infomaniak, IONOS…)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Installation dans un sous-dossier : décommentez et adaptez.
  # RewriteBase /mon-dossier/

  # Transmet l'en-tête Authorization à PHP (connecteur MCP, OAuth).
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Zones privées : jamais servies.
  RewriteRule ^(data|core|tests|bin)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  # Aucun autre script PHP que index.php n'est exécutable.
  RewriteRule ^(?!index\.php$).*\.php$ - [F,L]

  # Fichiers statiques existants (médias, thèmes, admin) : servis directement.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(css|js|svg|woff2|webp|avif|jpe?g|png|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/markdown application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType text/markdown .md
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
